From: az0x-firmware-kit
Subject: allocator_drm: use the rockchip-drm node

On the RK3288 with a mainline kernel the GPU (panfrost) owns renderD128
and card0; only rockchip-drm can make the dumb buffers MPP allocates.
Pick the DRM node whose driver is "rockchip", else the first that opens.

diff --git a/osal/allocator/allocator_drm.c b/osal/allocator/allocator_drm.c
index ef8371f..1c9461b 100644
--- a/osal/allocator/allocator_drm.c
+++ b/osal/allocator/allocator_drm.c
@@ -62,8 +62,28 @@ typedef struct {
 static const char *dev_drm[] = {
     "/dev/dri/renderD128",
     "/dev/dri/card0",
+    "/dev/dri/card1",
+    "/dev/dri/card2",
 };
 
+/*
+ * az0x/djaia: on a mainline kernel the GPU (panfrost) owns renderD128 and often card0;
+ * only rockchip-drm makes the dumb buffers we need. Prefer the node whose driver is
+ * "rockchip", then fall back to the first one that opens.
+ */
+static int drm_is_rockchip(int fd)
+{
+    char name[16] = { 0 };
+    struct drm_version v;
+
+    memset(&v, 0, sizeof(v));
+    v.name = name;
+    v.name_len = sizeof(name) - 1;
+    if (ioctl(fd, DRM_IOCTL_VERSION, &v) < 0)
+        return 0;
+    return !strcmp(name, "rockchip");
+}
+
 static RK_U32 to_rockchip_gem_mem_flag(RK_U32 flags)
 {
     RK_U32 ret = 0;
@@ -170,10 +190,22 @@ static MPP_RET os_allocator_drm_open(void **ctx, size_t alignment, MppAllocFlagT
 
     mpp_env_get_u32("drm_debug", &drm_debug, 0);
 
+    fd = -1;
     for (i = 0; i < (RK_S32)MPP_ARRAY_ELEMS(dev_drm); i++) {
-        fd = open(dev_drm[i], O_RDWR | O_CLOEXEC);
-        if (fd > 0)
+        RK_S32 f = open(dev_drm[i], O_RDWR | O_CLOEXEC);
+
+        if (f < 0)
+            continue;
+        if (drm_is_rockchip(f)) {
+            if (fd >= 0)
+                close(fd);
+            fd = f;
             break;
+        }
+        if (fd < 0)
+            fd = f;
+        else
+            close(f);
     }
 
     if (fd < 0) {

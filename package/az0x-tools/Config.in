config BR2_PACKAGE_AZ0X_TOOLS
	bool "az0x-tools (device helpers)"
	default y
	help
	  Small helpers for az0x devices. az0x-reboot restarts the
	  device with a reboot argument; "az0x-reboot loader" restarts
	  into Update Mode (fastboot). az0x-update installs an AZ01
	  update image (kit or stock) from a USB stick, SD card or /data
	  without a computer; az0x-img reads such images.

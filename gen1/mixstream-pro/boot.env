# U-Boot variables for the MixStream Pro, set before gen1/common/boot.cmd.
# Its panel is mounted the other way round from the Force's (dts rotation
# 90 vs 270), so the console needs rotate:1 to be upright.
setenv az0x_fbrotate 1
# No "synths" partition here, so /data is partition 7.
setenv az0x_datapart 7

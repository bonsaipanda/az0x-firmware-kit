# DHCP server for the USB network link to a PC (usb0).
CONFIG_UDHCPD=y
CONFIG_FEATURE_UDHCPD_WRITE_LEASES_EARLY=y
# Used by az0x-update and its RAM updater.
CONFIG_UNXZ=y
CONFIG_SHA1SUM=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_REALPATH=y
CONFIG_MOUNTPOINT=y
CONFIG_CHROOT=y
CONFIG_DF=y
CONFIG_DD=y
CONFIG_FEATURE_DD_IBS_OBS=y
CONFIG_SHELL_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_KILLALL5=y

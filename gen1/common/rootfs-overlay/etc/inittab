# az0x-firmware-kit inittab (BusyBox init)

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,ro /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# The application. Restarted if it exits; see /usr/libexec/az0x/app-launch.
tty1::respawn:/usr/libexec/az0x/app-launch

# Serial console (debug UART) for development.
ttyS2::respawn:/sbin/getty -L ttyS2 115200 vt100

# A login on the screen too (switch with Alt+F2 on a USB keyboard).
tty2::respawn:/sbin/getty 38400 tty2

::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r

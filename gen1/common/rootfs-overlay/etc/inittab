# az0x-firmware-kit inittab (BusyBox init)

::sysinit:/bin/mount -t proc proc /proc
# Quiet boot: the display driver wiped the screen; put the device's boot
# picture back as the very first thing.
::sysinit:/usr/libexec/az0x/splash
::sysinit:/bin/mount -o remount,ro /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/usr/libexec/az0x/mount-data
::sysinit:/bin/hostname -F /etc/hostname
# USB serial + network to a PC, before anything that could get stuck.
::sysinit:/usr/libexec/az0x/usb-gadget

# Start scripts run alongside the logins below (not before them), so a
# stuck script can't lock you out.
::once:/usr/libexec/az0x/rc-start

# The application. Waits for the start scripts, restarted if it exits.
tty1::respawn:/usr/libexec/az0x/app-launch

# Logins: debug UART, USB serial (ttyACM0 on the PC), screen (Alt+F2).
ttyS2::respawn:/sbin/getty -L ttyS2 115200 vt100
ttyGS0::respawn:/sbin/getty -L ttyGS0 115200 vt100
tty2::respawn:/sbin/getty 38400 tty2

::shutdown:/usr/libexec/az0x/shutdown
# az0x-update sends SIGQUIT: init stops everything, then runs this.
::restart:/usr/libexec/az0x/restart
